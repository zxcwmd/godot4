config_version=5

[application]

config/name="Aurora Launcher"
config/description="Современный лаунчер Minecraft с модулем автоматизации (автошахта, автоварка зелий, автоферма и др.)"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.2", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Bus="*res://scripts/core/bus.gd"
Net="*res://scripts/core/net.gd"
Store="*res://scripts/core/store.gd"
Notify="*res://scripts/core/notify.gd"
Java="*res://scripts/core/services/java_runtime.gd"
Mojang="*res://scripts/core/services/mojang.gd"
Loader="*res://scripts/core/services/loader_service.gd"
Mods="*res://scripts/core/services/modrinth.gd"
Game="*res://scripts/core/services/game_launcher.gd"
Bots="*res://scripts/core/automation/automation_service.gd"
Auth="*res://scripts/core/services/msauth.gd"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
